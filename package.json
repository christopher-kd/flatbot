{
	"name": "flatbot",
	"version": "0.1.0",
	"type": "module",
	"module": "tsconfig.app.json",
	"scripts": {
		"scraper": "bun src/scraper/run.ts",
		"setup": "bun src/setup/run.ts",
		"scraper-debug": "node --import tsx src/scraper/run.ts",
		"photon": "java -jar ./bin/photon/photon-1.2.1.jar serve -data-dir ./bin/photon",
		"test": "bun test",
		"migrate:coordinates-geojson": "bun src/db/migrateCoordinatesToGeoJson.ts",
		"lint": "bunx --bun @biomejs/biome lint",
		"lintfix": "bunx --bun @biomejs/biome lint --write ./src"
	},
	"dependencies": {
		"@clack/prompts": "^1.6.0",
		"bson": "7.2.0",
		"cli-progress": "^3.12.0",
		"colorette": "^2.0.20",
		"dlv": "^1.1.3",
		"dset": "^3.1.4",
		"figlet": "^1.11.0",
		"listr2": "^11.0.0",
		"mongodb": "^7.4.0",
		"node-html-parser": "^8.0.4",
		"parse5": "^8.0.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"pino-roll": "^4.0.0",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@types/bun": "^1.3.14",
		"@types/cli-progress": "^3.11.6",
		"@types/dlv": "^1.1.5",
		"@types/node": "^26.0.1",
		"tsx": "^4.23.0"
	}
}
