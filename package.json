{
	"name": "flatbot",
	"version": "0.1.0",
	"type": "module",
	"module": "tsconfig.app.json",
	"scripts": {
		"setup": "bunx playwright install chromium",
		"scraper": "bun src/scraper/run.ts",
		"scraper-debug": "node --import tsx src/scraper/run.ts",
		"photon": "java -jar ./photon/photon-1.2.1.jar serve -data-dir ./photon",
		"test": "bun test",
		"lint": "bunx --bun @biomejs/biome lint",
		"lintfix": "bunx --bun @biomejs/biome lint --write ./src"
	},
	"dependencies": {
		"@clack/prompts": "^1.6.0",
		"@playwright/test": "^1.49.0",
		"bson": "7.2.0",
		"colorette": "^2.0.20",
		"figlet": "^1.11.0",
		"mongodb": "^7.4.0",
		"node-html-parser": "^8.0.4",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"table": "^6.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.0.1",
		"pino-pretty": "^13.1.3",
		"pino-roll": "^4.0.0",
		"playwright": "~1.49.0",
		"tsx": "^4.23.0"
	}
}
