# Full connection string for an existing MongoDB replica set (required for
# transactions).
DB_CONN_STRING=mongodb://user:password@your-mongo-host:27017/?authSource=admin&replicaSet=rs0
DB_NAME=flatbot
DB_LISTINGS_COLLECTION=listings
DB_LISTINGS_ARCHIVE_COLLECTION=listings_archive

# Host/port of an existing Photon instance. Optional - if unreachable,
# coordinate backfill is skipped for that run
PHOTON_API_HOST=your-photon-host
PHOTON_API_PORT=2322

# How often the scraper runs, in seconds
SCRAPE_INTERVAL_SECONDS=600
